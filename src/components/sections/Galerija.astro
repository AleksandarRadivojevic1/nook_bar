---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const tiles = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);

// A larger rendition for the lightbox, where a photo fills the viewport rather
// than a grid cell.
const views = await Promise.all(
  tiles.map(async (tile) => ({
    src: tile.data.src,
    caption: tile.data.caption[locale],
    full: (await getImage({ src: tile.data.src, width: 1400, format: 'webp' })).src,
  })),
);
---

<section class="galerija" id="galerija" data-section="galerija" data-nav-surface="bone">
  <div class="g-fade g-fade-top" aria-hidden="true"></div>
  <div class="g-inner">
    <div class="g-panel">
      <div class="g-panel-head">
        <p class="eyebrow">{t.galerija.eyebrow}</p>
        <h2 class="display">{t.galerija.title}</h2>
      </div>
      <div class="g-panel-foot">
        <p class="sub">{t.galerija.note}</p>
        <div class="g-progress" aria-hidden="true">
          <span class="g-num">01</span>
          <span class="g-track"><span class="g-fill"></span></span>
          <span class="g-num">{String(tiles.length).padStart(2, '0')}</span>
        </div>
      </div>
    </div>

    <div class="g-cols">
      {
        [0, 1].map((col) => (
          <div class="g-col">
            {views
              .filter((_, i) => i % 2 === col)
              .map((view) => {
                const i = views.indexOf(view);
                return (
                  <button class="g-open" type="button" data-index={i} data-full={view.full} style={`order:${i}`}>
                    <Image
                      class="g-img"
                      src={view.src}
                      alt={view.caption}
                      widths={[400, 640, 960, 1280]}
                      sizes="(max-width:899px) 92vw, 28vw"
                    />
                    <span class="g-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  </button>
                );
              })}
          </div>
        ))
      }
    </div>
  </div>
  <div class="g-fade g-fade-bottom" aria-hidden="true"></div>
  <div class="grain is-fine"></div>
</section>

<div class="g-modal" id="galerija-modal" role="dialog" aria-modal="true" aria-label={t.galerija.title} hidden>
  <button class="g-modal-close" type="button">{t.galerija.close}</button>
  <div class="g-modal-center">
    <img class="g-modal-img" src="" alt="" />
    <p class="g-modal-caption" />
  </div>
  <div class="g-modal-nav">
    <button class="g-modal-prev" type="button">{t.galerija.prev}</button>
    <button class="g-modal-next" type="button">{t.galerija.next}</button>
  </div>
</div>

<script>
  import '../../scripts/galerija';
</script>

<style is:global>
/* ══════════════════════════════════════════════════════════════════════
   ACT 6 — GALERIJA  (pinned split)
   A left panel and two staggered columns of portrait photos. This is the
   static base: correct with no JS, on mobile, and under reduced motion. On
   desktop with motion on, galerija.ts pins the panel and scrolls the columns
   past it (the enhancement lives in a later step); everything here reads at
   rest without it.
   Each photo is a `.g-open` button so the lightbox is reachable by keyboard.
   ══════════════════════════════════════════════════════════════════════ */
.galerija{background:var(--bone);position:relative;overflow:clip}

.g-panel{max-width:40ch}
.g-panel .display{margin-top:1rem}
.g-panel .sub{margin-top:1.1rem}

.g-open{
  position:relative;
  display:block;width:100%;margin:0 0 clamp(1.4rem,3vw,2.6rem);
  padding:0;border:0;background:var(--bone);cursor:pointer;
  aspect-ratio:4/5;overflow:hidden;border-radius:14px;
  box-shadow:0 18px 50px rgba(58,54,40,.18);
}
.g-img{display:block;width:100%;height:100%;object-fit:cover}

.g-index{
  position:absolute;top:.9rem;right:.7rem;z-index:2;
  writing-mode:vertical-rl;
  font-family:var(--display);font-size:9px;letter-spacing:.28em;
  color:#F7F2E8;opacity:.86;text-shadow:0 1px 6px rgba(0,0,0,.45);
  pointer-events:none;
}

.g-progress{
  margin-top:2.4rem;display:flex;align-items:center;gap:.9rem;
  width:min(260px,70%);
  font-family:var(--display);font-size:10px;letter-spacing:.24em;color:var(--label);
  font-variant-numeric:tabular-nums;
}
.g-num{opacity:.7}
.g-track{flex:1;height:1px;background:var(--hair)}
.g-fill{display:block;height:100%;width:0;background:var(--olive-deep)}

/* The top band is pinned to the viewport, so photos dissolve into the bone as
   they scroll up past it. The bottom band is anchored to the section's end — it
   only appears once you reach the bottom, and never dims images mid-scroll. */
.g-fade{display:none;left:0;right:0;z-index:5;pointer-events:none}
.g-fade-top{position:sticky;top:0;height:20vh;margin-bottom:-20vh;background:linear-gradient(var(--bone),transparent)}
.g-fade-bottom{position:absolute;bottom:0;height:18vh;background:linear-gradient(transparent,var(--bone))}

/* ── Mobile / narrow: the reference read. One column of images scrolls behind
   a pinned heading (top) and a pinned note + progress (bottom); the edge fades
   dissolve the images into the bone at both. `order` on each photo restores the
   1→12 sequence after the two column wrappers collapse to display:contents. ── */
@media (max-width:899px){
  .g-inner{display:flex;flex-direction:column;position:relative;padding:0}
  .g-panel{display:contents}
  .g-panel-head{
    order:0;position:sticky;top:0;z-index:6;pointer-events:none;
    padding:calc(env(safe-area-inset-top) + 11vh) var(--gutter) 0;
  }
  .g-panel-foot{
    order:2;position:sticky;bottom:0;z-index:6;pointer-events:none;
    padding:6vh var(--gutter) calc(env(safe-area-inset-bottom) + 5vh);
    background:linear-gradient(transparent,var(--bone) 55%);
  }
  .g-panel-head .display{margin-top:.7rem}
  .g-progress{display:flex;margin-top:1.1rem}
  .g-cols{
    order:1;display:flex;flex-direction:column;
    padding:0 var(--gutter);margin-top:-9vh;
  }
  .g-col{display:contents}
  .g-fade{display:block}
  .g-fade-top{height:26vh;margin-bottom:-26vh}
  .g-fade-bottom{height:22vh}
}

/* ── Desktop: a sticky panel beside two staggered columns ── */
@media (min-width:900px){
  .g-inner{
    display:grid;grid-template-columns:34% 1fr;
    gap:clamp(2rem,5vw,5rem);padding:10vh var(--gutter) 8vh;
  }
  .g-panel{
    position:sticky;top:0;align-self:start;height:100vh;
    display:flex;flex-direction:column;justify-content:center;
  }
  .g-cols{
    display:grid;grid-template-columns:1fr 1fr;
    gap:clamp(1.2rem,2.6vw,2.4rem);align-items:start;
  }
  .g-col{will-change:transform}
  .g-fade{display:block}
}

/* ── Lightbox ──────────────────────────────────────────────────────────
   A sibling of the section, not a child: `.galerija` clips its overflow, and
   a fixed overlay has no business inheriting that. */
.g-modal[hidden]{display:none}
.g-modal{
  position:fixed;inset:0;z-index:120;
  display:flex;flex-direction:column;
  padding:clamp(1rem,3vw,2rem);
  background:rgba(20,14,7,.94);
  backdrop-filter:blur(6px);
}
body.g-modal-open{overflow:hidden}

.g-modal button{
  font-family:var(--display);font-size:10px;letter-spacing:.28em;text-transform:uppercase;
  color:#F7F2E8;background:none;border:0;padding:.7rem .2rem;cursor:pointer;
  opacity:.72;transition:opacity .3s ease;
}
.g-modal button:hover,.g-modal button:focus-visible{opacity:1}
.g-modal-close{align-self:flex-end}

.g-modal-center{
  flex:1;min-height:0;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:1.2rem;
}
.g-modal-img{
  max-width:min(100%,900px);max-height:70vh;
  width:auto;height:auto;object-fit:contain;
  display:block;
}
.g-modal-caption{
  margin:0;text-align:center;
  font-family:var(--display);font-size:11px;letter-spacing:.24em;text-transform:uppercase;
  color:#F7F2E8;
}
/* Each word rides in its own clipped box so the stagger reads as a reveal. */
.g-word{display:inline-block;overflow:hidden;vertical-align:bottom}
.g-word > span{display:inline-block;white-space:pre}

.g-modal-nav{display:flex;align-items:center;justify-content:space-between}

@media (prefers-reduced-motion: reduce){
  .g-modal{backdrop-filter:none}
  .g-word,.g-word > span{overflow:visible;transform:none}
}
</style>
