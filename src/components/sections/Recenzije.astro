---
import { getCollection } from 'astro:content';
import { fill, pluralNoun, useTranslations, type Locale } from '../../i18n';
import { langMarker, orderReviews } from '../../lib/reviews';
import { formatScore, site } from '../../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const reviews = orderReviews((await getCollection('reviews')).map((entry) => entry.data));

// These describe the live Google listing, not this collection.
/** "Google recenzija", or "Local Guide · 45 recenzija" for a Local Guide. */
function sourceLabel(source: 'google' | 'localGuide', guideReviews?: number): string {
  if (source !== 'localGuide') return t.recenzije.google;
  if (!guideReviews) return t.recenzije.localGuide;
  const noun = pluralNoun(guideReviews, locale, t.recenzije.reviewNoun);
  return `${t.recenzije.localGuide} · ${guideReviews} ${noun}`;
}

const claim = fill(t.recenzije.claim, {
  count: String(site.reviewCount),
  score: formatScore(site.reviewScore, locale),
});
---

<section
  class="reviews"
  id="recenzije"
  data-section="recenzije"
  data-nav-surface="bone"
  aria-label={t.recenzije.title}
>
  <div class="rev-orn" style="top:9%;left:4%"></div>
  <div class="rev-orn" style="bottom:11%;right:5%"></div>

  <div class="reviews-in">
    <header class="rev-head">
      <p class="rev-claim">{claim}</p>
      <p class="rev-note">{t.recenzije.note}</p>
    </header>

    <div class="rev-list">
      {
        reviews.map((review) => {
          const marker = langMarker(review.lang, locale);
          return (
            <figure class:list={['rev-item', review.featured && 'is-featured']}>
              <blockquote class="rev-quote">{review.quote}</blockquote>
              <figcaption class="rev-by">
                <b>{review.author}</b> · {sourceLabel(review.source, review.guideReviews)}
                {marker && (
                  <Fragment>
                    {' · '}
                    <span class="rev-lang">{marker}</span>
                  </Fragment>
                )}
              </figcaption>
            </figure>
          );
        })
      }
    </div>
  </div>
  <div class="grain is-fine"></div>
</section>

<script>
  import '../../scripts/recenzije';
</script>

<style is:global>
/* RECENZIJE — a page, not a widget. Quotes are verbatim; the EN marker says
   so. The debossed wordmark belongs to Siros now. */
.reviews{position:relative;background:var(--bone);padding:15vh var(--gutter) 12vh;overflow:hidden}
.reviews-in{position:relative;z-index:2;max-width:54rem;margin:0 auto}

.rev-head{max-width:34ch;margin-bottom:9vh}
/* Deliberately smaller than the pull-quote it introduces: the quotes are the
   substance and the claim is the frame. At the same scale the eye cannot tell
   which of the two is the heading. */
.rev-claim{font-family:var(--display);font-weight:300;font-size:clamp(1.1rem,2.1vw,1.62rem);
  line-height:1.42;color:var(--olive-deep);margin:0;text-wrap:pretty}
.rev-note{font-family:var(--display);font-size:10px;letter-spacing:.28em;text-transform:uppercase;
  color:var(--label);margin:1.5rem 0 0}

/* Varied scale in one column: featured quotes hold the full measure, the
   rest step in. No boxes anywhere — the rhythm does the separating. */
.rev-list{display:flex;flex-direction:column;gap:7vh}
.rev-item{margin:0;display:flex;flex-direction:column;gap:1.1rem}
.rev-item:not(.is-featured){padding-left:clamp(0rem,6vw,7rem)}

.rev-quote{font-family:var(--display);font-weight:300;color:var(--olive-deep);margin:0;
  text-wrap:pretty;font-size:clamp(.98rem,1.5vw,1.14rem);line-height:1.62;max-width:44ch}
.rev-item.is-featured .rev-quote{font-size:clamp(1.5rem,3.3vw,2.5rem);line-height:1.32;
  max-width:21ch}

.rev-by{font-family:var(--display);font-size:10px;letter-spacing:.28em;text-transform:uppercase;
  color:var(--label)}
.rev-by b{font-weight:500;color:var(--olive-deep)}
.rev-lang{opacity:.72}

/* the line-work survives as static corner ornament, with a little drift */
.rev-orn{position:absolute;z-index:1;pointer-events:none;opacity:.5}
.rev-orn svg{fill:none;stroke:rgba(124,124,94,.55);stroke-width:1.4;
  stroke-linecap:round;stroke-linejoin:round}
@media(max-width:760px){
  .rev-orn{display:none}
  .rev-item:not(.is-featured){padding-left:0}
  .rev-list{gap:5.5vh}
}
</style>
