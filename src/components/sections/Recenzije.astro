---
import { getCollection } from 'astro:content';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const reviews = (await getCollection('reviews')).sort((a, b) => a.data.order - b.data.order);
const stars = reviews[0]?.data.stars ?? 5;
const star = `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7L5.8 21l1.6-7L2 9.2l7.1-.6z"></path></svg>`;
---

<section class="reviews" id="recenzije" data-section="recenzije" data-nav-surface="bone">
  <div class="rev-mark deboss">Nook</div>

  <div class="rev-orn" style="top:9%;left:4%"></div>
  <div class="rev-orn" style="bottom:11%;right:5%"></div>

  <div class="reviews-in">
    <div class="rev-head">
      <div class="rev-score">{t.recenzije.score}</div>
      <div>
        <div class="rev-stars">
          {Array.from({ length: stars }).map(() => (
            <Fragment set:html={star} />
          ))}
        </div>
        <div class="rev-meta">{t.recenzije.meta}</div>
      </div>
    </div>

    <div class="rev-stack" id="revstack">
      {
        reviews.map((review) => (
          <figure class="rev-item">
            <blockquote class="rev-quote">{review.data.quote}</blockquote>
            <figcaption class="rev-by">
              <b>{review.data.author}</b> · {review.data.source}
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="rev-dots" id="revdots" role="tablist" aria-label={t.recenzije.title}>
      {
        reviews.map((_, i) => (
          <i role="tab" tabindex="0" aria-selected={i === 0 ? 'true' : 'false'} class={i === 0 ? 'on' : undefined} />
        ))
      }
    </div>
  </div>
  <div class="grain is-fine"></div>
</section>

<script>
  import '../../scripts/recenzije';
</script>

<style is:global>
/* ══════════════════════════════════════════════════════════════════════
   ACT 5 — RECENZIJE
   The debossed mark and the olive line-work were the good part of the old
   botanicals section, so they stay — but as a watermark and corner
   ornaments behind the one thing this page was missing: the reviews.
   5,0 from 20 is the strongest asset the business has and it was nowhere.

   Quotes are VERBATIM from public Google reviews, trimmed, attributed as
   first name + last initial. They are in English because that is how they
   were written; translating a real quote and presenting it as the person's
   words would not be honest.
   ══════════════════════════════════════════════════════════════════════ */
.reviews{position:relative;background:var(--bone);padding:15vh var(--gutter) 12vh;overflow:hidden}
.reviews-in{position:relative;z-index:2;max-width:64rem;margin:0 auto}

/* the debossed mark, now a watermark rather than the subject */
.rev-mark{
  position:absolute;z-index:1;left:50%;top:50%;translate:-50% -50%;opacity:.55;
  font-family:var(--display);font-weight:200;letter-spacing:.3em;text-transform:uppercase;
  font-size:clamp(5rem,17vw,15rem);line-height:1;white-space:nowrap;pointer-events:none;
}

.rev-head{display:flex;align-items:center;justify-content:center;gap:1.15rem;margin-bottom:6vh}
.rev-score{font-family:var(--display);font-weight:200;font-size:clamp(3rem,7vw,5.5rem);
  line-height:1;color:var(--olive-deep);font-variant-numeric:tabular-nums}
.rev-stars{display:flex;gap:.28rem;margin-bottom:.42rem}
.rev-stars svg{width:.9rem;height:.9rem;fill:var(--amber)}
.rev-meta{font-family:var(--display);font-size:10px;letter-spacing:.28em;text-transform:uppercase;
  color:var(--olive)}

.rev-stack{position:relative;min-height:13rem}
.rev-item{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;
  text-align:center;gap:1.6rem}
.rev-item:first-child{position:relative}
.rev-quote{font-family:var(--display);font-weight:300;font-size:clamp(1.2rem,2.5vw,2.05rem);
  line-height:1.44;color:var(--olive-deep);margin:0;max-width:24ch;text-wrap:pretty}
.rev-by{font-family:var(--display);font-size:10px;letter-spacing:.28em;text-transform:uppercase;
  color:var(--olive)}
.rev-by b{font-weight:500;color:var(--olive-deep)}

.rev-dots{display:flex;gap:.5rem;justify-content:center;margin-top:4vh}
.rev-dots i{width:5px;height:5px;border-radius:50%;background:var(--olive);opacity:.28;
  display:block;transition:opacity .4s}
.rev-dots i.on{opacity:.9}

/* the line-work survives as static corner ornament, with a little drift */
.rev-orn{position:absolute;z-index:1;pointer-events:none;opacity:.5}
.rev-orn svg{fill:none;stroke:rgba(124,124,94,.55);stroke-width:1.4;
  stroke-linecap:round;stroke-linejoin:round}
@media(max-width:760px){.rev-orn{display:none}.rev-stack{min-height:19rem}}


  /* Exactly one quote is visible by default; recenzije.ts takes over from
     here. The prototype achieved this with inline style="opacity:0" on the
     2nd and 3rd figures — expressed as CSS so it survives the list being
     generated from the collection. */
  .rev-item { opacity: 0; }
  .rev-item:first-child { opacity: 1; }
  .rev-dots i { cursor: pointer; }
</style>
