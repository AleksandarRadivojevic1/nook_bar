---
import { getCollection } from 'astro:content';
import { useTranslations, type Locale } from '../../i18n';
import serbiaPath from '../../assets/serbia.path.txt?raw';
import routePath from '../../assets/route.path.txt?raw';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const cards = (await getCollection('dan')).sort((a, b) => a.data.n - b.data.n);

// The route is drawn through these exact points. Derived from the cards, not
// eyeballed — see src/assets/ASSETS.md.
const anchors = cards.map((c) => c.data.anchor);
---

<section class="journey" id="dan" data-section="dan" data-nav-surface="bone">
  <div class="journey-head">
    <h2 class="display is-wide" style="font-size:clamp(1.15rem,2vw,1.7rem)">{t.dan.title}</h2>
    <p class="sub">{t.dan.sub}</p>
  </div>

  <div class="journey-stage" id="jstage">
    <!-- Serbia INCLUDING Kosovo: a union of OSM relation/1741311 and
         relation/2088990, computed with polygon-clipping so the two are one
         landmass with NO internal border drawn. Boundary data (c)
         OpenStreetMap contributors, ODbL. Kosovo is included at the owner's
         explicit direction — see src/assets/ASSETS.md before regenerating. -->
    <div class="journey-art">
      <svg viewBox="0 0 1000 1435.4" preserveAspectRatio="none" aria-hidden="true">
        <g><line class="j-grid" x1="250" y1="42" x2="250" y2="1393"></line><line class="j-grid" x1="500" y1="42" x2="500" y2="1393"></line><line class="j-grid" x1="750" y1="42" x2="750" y2="1393"></line><line class="j-grid" x1="34" y1="287" x2="966" y2="287"></line><line class="j-grid" x1="34" y1="574" x2="966" y2="574"></line><line class="j-grid" x1="34" y1="861" x2="966" y2="861"></line><line class="j-grid" x1="34" y1="1148" x2="966" y2="1148"></line></g>
        <path class="j-country" d={serbiaPath.trim()}></path>
        <path class="j-route-ghost" id="jghost" d={routePath.trim()}></path>
        <path class="j-route" id="jroute" d={routePath.trim()}></path>
        <circle class="j-pin-ring" cx="747.1" cy="1059.2" r="28"></circle>
        <circle class="j-pin" cx="747.1" cy="1059.2" r="7"></circle>
        <text class="j-pin-label" x="789.1" y="1066.2">{t.dan.pin}</text>
        <circle class="j-tip-halo" id="jtiphalo" cx="-99" cy="-99" r="17"></circle>
        <circle class="j-tip" id="jtip" cx="-99" cy="-99" r="5.5"></circle>
      </svg>
    </div>

    {
      cards.map((card) => (
        <article class:list={['j-item', `is-${card.data.n}`]}>
          <div class="j-num">{String(card.data.n).padStart(2, '0')}</div>
          <div class="j-media">
            <div class="j-media-img" style={`background:${card.data.media}`} />
            <div class="j-media-veil" />
          </div>
          <h3>{card.data.title[locale]}</h3>
          <p>{card.data.body[locale]}</p>
          <span class="when">{card.data.when[locale]}</span>
        </article>
      ))
    }

    <div class="j-arrive" id="jarrive" style="top:76.2%;left:78.3%">
      <span class="script">{t.dan.arriveScript}</span>
      <p class="eyebrow">{t.dan.arrive}</p>
    </div>
  </div>
  <div class="grain is-fine"></div>

  <script type="application/json" id="janchors" set:html={JSON.stringify(anchors)} is:inline />
</section>

<script>
  import '../../scripts/dan';
</script>

<style is:global>
/* ══════════════════════════════════════════════════════════════════════
   ACT 3 — JEDAN DAN  (Flyward's "how we support every journey")
   A hand-drawn route runs down the page and the numbered cards are pinned
   alternately left and right along it, so the route is what visually
   connects the pictures. Serbia's real boundary and a survey field sit
   behind. The route terminates at Leskovac's true coordinate.

   The stage keeps Serbia's own aspect ratio (0.759) so preserveAspectRatio
   ="none" introduces no distortion, which in turn means every viewBox
   coordinate maps linearly to a percentage — that is how the cards line up
   with the route without hand-tuning two coordinate systems.
   ══════════════════════════════════════════════════════════════════════ */
.journey{background:var(--sand);padding:14vh 0 5vh;position:relative;overflow:clip}
.journey-head{padding:0 var(--gutter);margin-bottom:4vh;text-align:center}
.journey-head .sub{margin:1.1rem auto 0;max-width:34ch}

.journey-stage{position:relative;width:100%;max-width:1140px;margin:0 auto;aspect-ratio:1000/1435.4}
.journey-art{position:absolute;inset:0;z-index:1}
.journey-art svg{width:100%;height:100%;display:block}
.j-country{fill:rgba(124,124,94,.05);stroke:rgba(69,69,52,.62);stroke-width:2;
  vector-effect:non-scaling-stroke;stroke-linejoin:round}
.j-grid{stroke:rgba(124,124,94,.26);stroke-width:1;vector-effect:non-scaling-stroke}
.j-route{fill:none;stroke:rgba(201,138,68,.82);stroke-width:1.8;vector-effect:non-scaling-stroke;
  stroke-linecap:round}
/* the whole route, faint — you can see where it is going before it gets there */
.j-route-ghost{fill:none;stroke:rgba(124,124,94,.30);stroke-width:1.4;
  vector-effect:non-scaling-stroke;stroke-dasharray:2 8;stroke-linecap:round}
/* the pen tip: rides the path as you scroll, drawing the line behind it */
.j-tip{fill:var(--amber)}
.j-tip-halo{fill:rgba(201,138,68,.18)}
.j-pin{fill:var(--amber)}
.j-pin-ring{fill:none;stroke:var(--amber);stroke-width:1.4;vector-effect:non-scaling-stroke;opacity:.55}
.j-pin-label{font-family:var(--display);font-size:19px;letter-spacing:.26em;
  text-transform:uppercase;fill:var(--olive-deep)}

/* cards, pinned along the route */
.j-item{position:absolute;z-index:3;width:18%;min-width:168px}
.j-item.is-1{top:8%;right:8%}
.j-item.is-2{top:28%;left:8%}
.j-item.is-3{top:46%;right:10%}
.j-item.is-4{top:62%;left:12%}
.j-media{position:relative;aspect-ratio:1/1.23;overflow:hidden;background:var(--sand);
  box-shadow:inset 0 0 0 1px rgba(124,124,94,.30),0 14px 34px rgba(58,54,40,.10)}
.j-media-img{position:absolute;inset:0}
.j-media-veil{position:absolute;inset:0;will-change:opacity;
  background:linear-gradient(180deg,var(--sand),rgba(211,195,163,.45) 60%,rgba(211,195,163,0))}
.j-num{
  position:absolute;top:-1.1rem;right:-1.1rem;z-index:4;
  width:2.4rem;height:2.4rem;border-radius:50%;
  background:var(--olive-deep);color:var(--bone);
  display:grid;place-items:center;
  font-family:var(--display);font-size:.92rem;font-variant-numeric:tabular-nums;
}
.j-item h3{font-family:var(--display);font-weight:400;letter-spacing:.16em;text-transform:uppercase;
  font-size:clamp(.78rem,1vw,.95rem);color:var(--olive-deep);margin:1.1rem 0 .35rem}
.j-item p{margin:0;font-size:.84rem;line-height:1.6;color:#6A6552}
.j-item .when{display:block;margin-top:.5rem;font-family:var(--display);font-size:10px;
  letter-spacing:.24em;color:var(--olive);font-variant-numeric:tabular-nums}

/* closing beat: the route terminates on the bar's real coordinate, so say so
   there instead of leaving the lower third of the boundary empty */
.j-arrive{position:absolute;z-index:3;max-width:15rem}
.j-arrive .script{display:block;font-size:clamp(1.5rem,2.6vw,2.3rem);color:var(--olive-deep)}
.j-arrive .eyebrow{margin-top:.5rem}

/* Mobile: the stage would be far too short to hold four cards at Serbia's
   aspect, so the map becomes a faint backdrop and the cards return to flow. */
@media(max-width:820px){
  .journey-stage{aspect-ratio:auto;display:flex;flex-direction:column;gap:3rem;
    padding:2rem var(--gutter) 0}
  /* preserveAspectRatio="none" is fine on desktop because the stage matches
     the boundary's aspect — but here the stage is as tall as four stacked
     cards, which would stretch Serbia grotesquely. Give the backdrop its own
     correctly-proportioned box instead. object-fit does nothing to an inline
     SVG's internal scaling, so it cannot be fixed from the svg element. */
  .journey-art{
    inset:auto;top:4%;left:50%;translate:-50% 0;
    width:155%;height:auto;aspect-ratio:1000/1435.4;opacity:.5;
  }
  .j-item{position:static;width:100%;min-width:0;max-width:22rem}
  .j-item.is-2,.j-item.is-4{margin-left:auto}
  .j-route{display:none}
  .j-tip,.j-tip-halo{display:none}
  .j-arrive{position:static;max-width:none;text-align:center;margin-top:1rem}
}


  @media (prefers-reduced-motion: reduce) {
    /* The veil's only path to transparent is GSAP; without this the four card
       images stay covered forever. */
    .j-media-veil { opacity: 0; }
    .j-item { opacity: 1; transform: none; }
    .j-num { opacity: 1; transform: none; }
    #jroute { stroke-dashoffset: 0 !important; }
    #jtip, #jtiphalo { opacity: 0; }
    .j-pin, .j-pin-ring { transform: none; opacity: 1; }
    #jarrive { opacity: 1; transform: none; }
  }
</style>
