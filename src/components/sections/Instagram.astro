---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { useTranslations, type Locale } from '../../i18n';
import { recentPosts } from '../../lib/instagram';
import { site } from '../../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const posts = recentPosts((await getCollection('instagram')).map((entry) => entry.data));
---

{
  posts.length > 0 && (
    <section class="ig" id="instagram" data-section="instagram" data-nav-surface="ink">
      <div class="ig-head">
        <p class="eyebrow">{t.instagram.eyebrow}</p>
        <h2 class="display">{t.instagram.title}</h2>
        <a class="ig-follow" href={site.instagramUrl} target="_blank" rel="noopener noreferrer">
          {site.instagramHandle} · {t.instagram.follow}
        </a>
      </div>

      <ul class="ig-row" style={`--tiles:${posts.length}`}>
        {posts.map((post) => (
          <li class="ig-tile">
            <a href={post.permalink} target="_blank" rel="noopener noreferrer">
              <Image src={post.image} alt={post.caption[locale]} width={520} height={520} />
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style is:global>
/* ══════════════════════════════════════════════════════════════════════
   ACT 11 — INSTAGRAM
   Last, on ink, four sections away from Galerija so the two photo grids
   never compete, and continuous with the footer. Its job is "this is where
   we keep talking", not "look at the room".

   Every tile is a real post that links to itself, so the section is honest
   without claiming to be live. There is no API behind it and deliberately
   so — see src/content/schemas.ts.
   ══════════════════════════════════════════════════════════════════════ */
.ig{background:var(--ink);padding:14vh var(--gutter) 12vh;position:relative}

.ig-head{max-width:36ch;margin-bottom:6vh}
.ig .eyebrow{color:#9C9478}
.ig .display{
  font-size:clamp(1.5rem,3.2vw,2.4rem);line-height:1.2;
  color:#F7F2E8;margin:1rem 0 0;text-wrap:balance;
}
.ig-follow{
  display:inline-block;margin-top:1.5rem;
  font-family:var(--display);font-size:10px;letter-spacing:.28em;text-transform:uppercase;
  color:#CFC6AE;text-decoration:none;
  border-bottom:1px solid rgba(207,198,174,.32);padding-bottom:.35rem;
  transition:color .4s ease,border-color .4s ease;
}
.ig-follow:hover{color:var(--amber);border-color:var(--amber)}

/* --tiles is however many actually rendered, so a short row NARROWS rather
   than stretching three images across the width of four. */
.ig-row{
  list-style:none;margin:0;padding:0;display:grid;
  grid-template-columns:repeat(var(--tiles,4),minmax(0,1fr));
  gap:clamp(.6rem,1.4vw,1.1rem);
}
.ig-tile{margin:0}
.ig-tile a{display:block;overflow:hidden;background:#2A2820}
/* Square-cropped so mixed source ratios do not break the row. */
.ig-tile img{
  display:block;width:100%;height:auto;aspect-ratio:1;object-fit:cover;
  filter:saturate(.88);
  transition:transform .9s cubic-bezier(.2,.7,.2,1),filter .6s ease;
}
.ig-tile a:hover img{transform:scale(1.05);filter:saturate(1)}

@media(max-width:760px){
  .ig{padding:11vh var(--gutter) 10vh}
  /* Two columns, but never more columns than there are tiles. */
  .ig-row{grid-template-columns:repeat(min(var(--tiles,4),2),minmax(0,1fr))}
}

@media (prefers-reduced-motion: reduce){
  .ig-tile img{transition:none}
  .ig-tile a:hover img{transform:none}
}
</style>
