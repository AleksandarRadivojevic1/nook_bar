---
import { useTranslations, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

---

<section class="hero" id="hero" data-section="hero" data-nav-surface="dark">
  <div class="stage">
    <div class="scene">
      <!-- Two pre-canvas backdrops. Motion starts on frame 0, so its poster is
           that frame — the canvas then paints the same frame with no jump. The
           held-clink poster is the reduced-motion / no-JS finished read. -->
      <img class="scene-poster scene-poster-motion" src="/hero/frames/desk/f_001.webp" alt="" aria-hidden="true" />
      <img class="scene-poster scene-poster-still" src="/hero/frames/poster.webp" alt="" aria-hidden="true" />
      <canvas class="scene-canvas" data-count={132} data-enter={60} aria-hidden="true"></canvas>
      <!-- Mobile hero: a hardware-decoded autoplay loop replaces the scroll-
           scrubbed canvas, which can't stay smooth on a phone. -->
      <video
        class="scene-video"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        poster="/hero/frames/poster.webp"
        aria-hidden="true"
      >
        <source src="/hero/hero.webm" type="video/webm" />
        <source src="/hero/hero.mp4" type="video/mp4" />
      </video>
      <div class="scene-veil"></div>
      <!-- holds contrast under the centred light-on-dark copy; without it the
           headline sits directly on the footage and washes out -->
      <div class="scene-scrim"></div>
    </div>

    <!-- survey field, beneath the wall so the wall's growth wipes it away -->
    <div class="survey" id="survey">
      <svg viewBox="0 0 1440 900" preserveAspectRatio="none" aria-hidden="true">
        <rect class="ln" x="54" y="112" width="1332" height="676" fill="none"></rect>
        <line class="ln" x1="54" y1="424" x2="1386" y2="424"></line>
        <line class="ln" x1="400" y1="112" x2="400" y2="788"></line>
        <line class="ln" x1="746" y1="112" x2="746" y2="788"></line>
        <line class="ln" x1="1092" y1="112" x2="1092" y2="788"></line>
        <path class="arc" d="M54 168C420 470 1020 470 1386 168"></path>
        <path class="arc" d="M54 788C420 486 1020 486 1386 788"></path>
        <g class="star">
          <path d="M164 410v28M150 424h28"></path>
          <path d="M155 415l18 18M173 415l-18 18"></path>
        </g>
        <g class="star">
          <path d="M1328 410v28M1314 424h28"></path>
          <path d="M1319 415l18 18M1337 415l-18 18"></path>
        </g>
      </svg>
    </div>

    <div class="wall-wrap">
      <div class="matte" id="matte">
        <!-- Syros - real OSM coastline (relation 531999, via Nominatim),
             2207 points, 1000x1614. The wall is an oversized rect with the
             coastline as the mask's hole, so the ISLAND is the hole and the
             warm room shows through it. -->
        <svg viewBox="0 0 1000 1614.2" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <defs>
            <!-- The coastline itself is defined once per document by
                 SyrosPath.astro; both the mask below and the Siros section
                 reference it, rather than inlining 29KB of path data twice. -->
            <mask id="seaMask" maskUnits="userSpaceOnUse" x="-3000" y="-3000" width="7000" height="7614">
              <rect x="-3000" y="-3000" width="7000" height="7614" fill="#fff"></rect>
              <!-- The reveal scales THIS, not the element around it. See the
                   note over .matte for why that distinction matters. -->
              <g class="isle" id="isle-hole"><use href="#syros" fill="#000"></use></g>
            </mask>
          </defs>
          <rect
            class="wall"
            x="-3000"
            y="-3000"
            width="7000"
            height="7614"
            mask="url(#seaMask)"></rect>
          <g class="isle" id="isle-lip"><use class="lip" id="coast" href="#syros"></use></g>
        </svg>
      </div>
    </div>

    <div class="grain grain-stage"></div>

    <div class="readout is-left" id="ro1">
      {t.hero.readoutInspiration} · <b>{t.hero.readoutSyros}</b><br />37,4°&nbsp;N · 24,9°&nbsp;E
    </div>
    <div class="readout is-right" id="ro2">
      {t.hero.readoutBar} · <b>{t.hero.readoutCity}</b><br />43,0°&nbsp;N · 21,9°&nbsp;E
      <span class="bar"></span>
    </div>
  </div>

  <!-- outside .stage, so it scrolls past the sticky stage -->
  <div class="hero-copy">
    <div class="hero-block is-first" id="hb1">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 class="display">{t.hero.headlineLine1}<br />{t.hero.headlineLine2}</h1>
      <p class="sub">{t.hero.sub}</p>
    </div>
    <div class="hero-block is-over" id="hb2">
      <div class="wordmark-lg">Nook</div>
      <p class="script">{t.hero.script}</p>
      <p class="sub">{t.hero.over}</p>
    </div>
  </div>
</section>

<script>
  import '../../scripts/hero';
</script>

<style is:global>
/* ══════════════════════════════════════════════════════════════════════
   ACT 1 — THE NOOK
   300vh wrapper; ONE sticky stage. The bone wall has the coastline punched out
   of it by a mask. Scrolling grows the hole inside a wall that never moves; the
   picture behind is never transformed, so it never resamples. Copy lives
   OUTSIDE the sticky stage so it can scroll past it.
   ══════════════════════════════════════════════════════════════════════ */
.hero{position:relative;height:760vh}
.stage{position:sticky;top:0;height:100vh;overflow:hidden;background:var(--bone)}

/* the warm room — the real bar footage, revealed through the coastline hole */
.scene{position:absolute;inset:0;z-index:1;background:#1B1409;overflow:hidden}
/* The poster is the always-on backdrop; the canvas draws the scrubbed frame
   over it and only becomes visible once the player has painted a frame. */
.scene-poster,.scene-canvas{position:absolute;inset:0;width:100%;height:100%}
.scene-poster{object-fit:cover;object-position:center}
.scene-poster-still{display:none}
.scene-canvas{opacity:0;transition:opacity .4s ease}
.scene-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:none}
.scene-scrim{
  position:absolute;inset:0;
  background:radial-gradient(50% 38% at 50% 43%, rgba(20,14,7,.74), rgba(20,14,7,.32) 60%, rgba(20,14,7,0) 82%);
}
/* vignette: corners fall away so the full-bleed state still has a centre */
.scene-veil{
  position:absolute;inset:0;
  background:
    radial-gradient(120% 100% at var(--arch-x) var(--glass-y), rgba(20,14,7,0) 32%, rgba(20,14,7,.74) 100%),
    linear-gradient(180deg,rgba(20,14,7,.46),rgba(20,14,7,0) 34%,rgba(20,14,7,.52));
}

/* Flyward's ornament layer: a hairline survey field inset from the edges,
   four-point stars on the intersections, one dashed great-circle arc. It
   sits UNDER the wall so the wall's growth wipes it away. */
.survey{position:absolute;inset:0;z-index:4;pointer-events:none;opacity:.62}
.survey svg{width:100%;height:100%;display:block}
.survey .ln{stroke:var(--olive);stroke-width:.7;opacity:.30}
.survey .arc{stroke:var(--olive);stroke-width:.7;opacity:.26;fill:none;stroke-dasharray:3 6}
.survey .star{stroke:var(--olive);stroke-width:.8;opacity:.45}

/* the wall, with Syros cut out of it */
.wall-wrap{position:absolute;inset:0;z-index:3;pointer-events:none}
/* The element itself is NEVER transformed. The wall it carries is ~5,900px
   square at 1920x900; scaling the element by the reveal's 14x would ask the
   compositor to rasterise that at ~83,000px square, far past what it will
   allocate — it drops tiles, and the wall comes back in bone fragments once you
   scroll to the bottom and return to the top. The reveal scales the island
   geometry inside the SVG instead, so every frame rasterises within this box. */
.matte{
  position:absolute;left:var(--arch-x);top:var(--arch-y);translate:-50% -50%;
  height:152vh;aspect-ratio:1000/1614.2;
}
.matte svg{width:100%;height:100%;overflow:visible}
.matte .wall{fill:var(--bone)}
/* the coastline itself, drawn on by scrubbed dashoffset — the one thing
   Flyward also scrubs. non-scaling-stroke keeps it hairline at any scale. */
.matte .lip{
  fill:none;stroke:rgba(124,124,94,.55);stroke-width:1.1;
  vector-effect:non-scaling-stroke;stroke-linejoin:round;
}

/* cartographic chrome, bottom corners */
.readout{
  position:absolute;bottom:2.4vh;z-index:7;
  font-family:var(--display);font-size:9.5px;letter-spacing:.26em;text-transform:uppercase;
  color:var(--label);font-variant-numeric:tabular-nums;transition:color .55s ease;
}
.readout.is-left{left:var(--gutter)}
.readout.is-right{right:var(--gutter);text-align:right}
.readout b{font-weight:500;color:var(--olive-deep);transition:color .55s ease}
.readout.on-dark{color:rgba(242,236,225,.72)}
.readout.on-dark b{color:#F7F2E8}
.readout .bar{display:block;width:74px;height:1px;background:currentColor;opacity:.5;margin:.45rem 0 0}
.readout.is-right .bar{margin-left:auto}
@media(max-width:760px){.readout.is-right{display:none}}

.grain-stage{z-index:6}

.cue{
  position:absolute;left:var(--gutter);bottom:2.4vh;z-index:7;
  display:flex;align-items:center;gap:.8rem;
  font-family:var(--display);font-size:9px;letter-spacing:.34em;text-transform:uppercase;
  color:var(--label);
}
.cue i{display:block;width:38px;height:1px;background:currentColor;
  transform-origin:left;animation:drop 2.4s ease-in-out infinite}
@keyframes drop{0%,100%{scale:.2 1;opacity:.28}50%{scale:1 1;opacity:.85}}

/* copy: sibling of .stage, so it scrolls past it.
   Both blocks are centred on the island, light-on-dark, as Flyward does —
   the shape is the stage the type stands on. */
.hero-copy{position:absolute;inset:0;z-index:8;pointer-events:none}
.hero-block{height:auto;display:flex;flex-direction:column;padding:0 var(--gutter);gap:1.4rem}
.hero-block.is-first{height:100vh;justify-content:center;align-items:center;text-align:center;gap:1.15rem}
.hero-block.is-first .display{max-width:14ch;color:#F7F2E8}
.hero-block.is-first .eyebrow{color:rgba(242,222,182,.86)}
.hero-block.is-first .sub{max-width:25ch;color:rgba(247,242,232,.88)}
/* The headline runs wider than the knockout matte, so its ends spill onto the
   bone background where white would vanish. A soft dark halo keeps the copy
   legible over both the landmass and the bone, without touching the layout. */
.hero-block.is-first .display,
.hero-block.is-first .sub,
.hero-block.is-first .eyebrow{
  text-shadow:0 1px 2px rgba(20,14,7,.5),0 0 26px rgba(20,14,7,.62);
}
/* second block: centred over the opened room, light on dark */
.hero-block.is-over{height:240vh;justify-content:center;align-items:center;text-align:center;gap:.5rem}
.hero-block.is-over .display,.hero-block.is-over .eyebrow{color:#F7F2E8}
.hero-block.is-over .sub{color:rgba(247,242,232,.84);max-width:30ch;margin-top:1rem}
.hero-block.is-over .script{color:rgba(242,222,182,.92)}
.wordmark-lg{font-family:var(--display);font-weight:200;letter-spacing:.4em;text-transform:uppercase;
  font-size:clamp(1.7rem,3.4vw,3rem);color:#F7F2E8}
/* Mobile: there is no room for type beside the opening, so it stacks —
   type in the upper third, the doorway filling the lower two thirds and
   bleeding off the bottom edge, same logic as desktop. The first block is
   capped at 100vh so its content stays above the fold (at 150vh it lands
   below it), and the second absorbs the remaining 200vh. */
/* Mobile: the island is already narrow, so size it by WIDTH here — at 126vh
   on a 390x844 screen it would be a sliver. Copy stays centred on it. */
@media(max-width:760px){
  :root{--key-y:66%;--glass-y:80%;--counter-y:92%}
  /* One-screen video hero; the scroll-scrub is desktop-only. */
  .hero{height:100vh}
  .scene-video{display:block}
  .scene-canvas,.scene-poster,.matte,.survey,.readout{display:none}
  .hero-block.is-over{display:none}
  .hero-block.is-first{max-width:none;gap:1.05rem}
  .hero-block.is-first .display{max-width:16ch}
  .cue{display:none}
}


  /* The animated properties carry their FINISHED value here; hero.ts rewinds
     them at init when it is actually going to run. With reduced motion nothing
     runs and the hero reads as the completed design. */
  @media (prefers-reduced-motion: reduce) {
    .scene-poster-motion { display: none; }
    .scene-poster-still { display: block; }
    .matte { display: none; }
    .survey { opacity: 0; }
    .readout { display: none; }
    .hero { height: auto; }
    .stage { position: relative; }
    .hero-copy { position: static; }
    .hero-block.is-first { height: 100vh; }
    .hero-block.is-over { height: auto; padding: 12vh var(--gutter); background: #2A1D0F; }
  }
</style>
