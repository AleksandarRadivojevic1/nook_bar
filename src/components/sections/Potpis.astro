---
import { getCollection } from 'astro:content';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const drinks = (await getCollection('signature')).sort((a, b) => a.data.order - b.data.order);
---

<section class="potpis" id="potpis" data-section="potpis" data-nav-surface="bone">
  <div class="potpis-head">
    <p class="eyebrow">{t.potpis.eyebrow}</p>
    <h2 class="display">{t.potpis.title}</h2>
    <p class="sub">{t.potpis.note}</p>
  </div>

  <div class="p-rows">
    {
      drinks.map((drink, i) => (
        <article class:list={['p-drink', i % 2 === 1 && 'is-flipped']}>
          <div class="p-media">
            <div class="p-media-img" style={`background:${drink.data.media}`} />
          </div>
          <div class="p-body">
            <div class="p-row">
              <h3>{drink.data.name}</h3>
              <span class="p-price">
                {t.karta.currency} {drink.data.price}
              </span>
            </div>
            <p class="p-tagline script">{drink.data.tagline[locale]}</p>
            <p class="p-spec sub">{drink.data.spec[locale]}</p>
            {drink.data.notes && <p class="p-notes">{drink.data.notes[locale]}</p>}
            {drink.data.origin && <p class="p-origin eyebrow">{drink.data.origin[locale]}</p>}
          </div>
        </article>
      ))
    }
  </div>
  <div class="grain is-fine"></div>
</section>

<script>
  import '../../scripts/potpis';
</script>

<style is:global>
/* ══════════════════════════════════════════════════════════════════════
   ACT 5 — POTPIS  (signature drinks)
   The menu (Karta) is the full, changing list; this is the short list the bar
   is known for. Three feature cards on the sand ground, one carrying the
   Syros name so the section is tied back to the hero's readout.
   ══════════════════════════════════════════════════════════════════════ */
.potpis{background:var(--sand);padding:16vh var(--gutter) 14vh;position:relative;overflow:clip}
.potpis-head{max-width:40ch}
.potpis-head .display{margin-top:1rem}
.potpis-head .sub{margin-top:1.1rem}

/* Alternating full-width rows, not a grid of squares.
   Three identical cards with a name and a price have nowhere to put a
   tasting note, which is the thing the owners actually want to say about
   these drinks. It also removes the last identical-card grid on a page that
   avoids them everywhere else. */
.p-rows{display:flex;flex-direction:column;gap:clamp(4rem,8vh,7rem);margin-top:9vh}

.p-drink{
  display:grid;align-items:center;
  /* The image is the smaller half. It is a stand-in gradient today and will
     be a photograph later, but either way the words are the point of this
     section and a dominant image makes the column beside it look starved. */
  grid-template-columns:minmax(0,.92fr) minmax(0,1fr);
  gap:clamp(1.75rem,5vw,4.5rem);
}
/* Every other row puts the image on the right. Done with explicit columns
   rather than row-reverse so the DOM order stays image-then-name for a
   screen reader on every row. */
.p-drink.is-flipped .p-media{grid-column:2;grid-row:1}
.p-drink.is-flipped .p-body{grid-column:1;grid-row:1}

.p-media{
  aspect-ratio:4/3;overflow:hidden;background:var(--bone);
  box-shadow:inset 0 0 0 1px rgba(69,69,52,.16),0 20px 46px rgba(58,54,40,.16);
}
.p-media-img{width:100%;height:100%;transition:transform .9s cubic-bezier(.2,.7,.2,1)}
.p-drink:hover .p-media-img{transform:scale(1.055)}

.p-body{max-width:34ch}
.p-row{display:flex;justify-content:space-between;align-items:baseline;gap:1rem}
.p-drink h3{
  font-family:var(--display);font-weight:400;letter-spacing:.05em;
  font-size:clamp(1.25rem,1.9vw,1.7rem);color:var(--olive-deep);margin:0;transition:color .4s ease;
}
.p-drink:hover h3{color:var(--amber-text)}
.p-price{font-family:var(--display);font-weight:400;font-size:.86rem;letter-spacing:.1em;
  color:var(--label);font-variant-numeric:tabular-nums;white-space:nowrap}

/* The tagline carries the row. It is the best line each drink has, and until
   the tasting notes are written it is the only prose in the column. */
.p-tagline{margin:1rem 0 0;font-size:clamp(1.25rem,2.2vw,1.75rem);color:var(--olive-deep)}
.p-spec{margin:1.1rem 0 0;color:var(--ink-soft);max-width:none}
.p-notes{
  font-family:var(--body);font-size:clamp(.92rem,1.1vw,1rem);line-height:1.7;
  color:var(--ink-soft);margin:1.1rem 0 0;text-wrap:pretty;
}
.p-origin{margin-top:1.2rem;color:var(--label)}

@media(max-width:820px){
  /* One column, image first on every row: an alternation nobody can see is
     just an inconsistency. */
  .p-rows{gap:4.5rem;margin-top:7vh}
  .p-drink,.p-drink.is-flipped{display:block}
  .p-drink.is-flipped .p-media,.p-drink.is-flipped .p-body{grid-column:auto;grid-row:auto}
  .p-media{aspect-ratio:4/5}
  .p-body{max-width:none;padding-top:1.25rem}
}

  /* Finished state lives here; potpis.ts rewinds it to play the cards in as
     they are reached. With reduced motion nothing runs and they read as final. */
  @media (prefers-reduced-motion: reduce){
    .p-drink{opacity:1;transform:none}
    .p-media-img{transition:none}
  }
</style>
