---
import { useTranslations, type Locale } from '../i18n';
import { blockMap } from '../lib/blockmap';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Thickest first. Drawing through-roads under the service lanes is what keeps
// them reading as continuous rather than being nicked at every junction.
const byRank = [...blockMap.streets].sort((a, b) => a.rank - b.rank);
const WIDTH = { 1: 7, 2: 4.2, 3: 2 } as const;

// Google's own place-embed (Share → Embed a map). Unlike `?q=…&output=embed`,
// this drops the real "Nook Bar" marker via the place id. `1s${locale}` sets
// the map's UI language to match the page.
const embed = `https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2730.745009375763!2d21.9487068709841!3d42.992217109123956!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x475583b9f6d86b21%3A0x92235e0373ac5293!2sNook%20Bar!5e0!3m2!1s${locale}!2srs!4v1785935700502!5m2!1s${locale}!2srs`;

/**
 * A window on the asset rather than the whole of it, in metres, centred on
 * the bar. The generator's radius pulls in more than the block, and the full
 * extent is a near-square that renders as a tall slab in the middle of the
 * section. Landscape and tighter reads as a map of somewhere, and roads that
 * run off the edges are what make it look like a map at all rather than an
 * island of streets floating in bone.
 *
 * Cropping here rather than in the generator keeps the asset general: the
 * next thing that needs it can choose its own window.
 */
const VIEW_W = 440;
const VIEW_H = 300;
const view = {
  x: blockMap.bar.x - VIEW_W / 2,
  y: blockMap.bar.y - VIEW_H / 2,
};
---

<figure
  class="mapf"
  data-embed={embed}
  data-title={t.kontakt.mapLabel}
  style={`aspect-ratio:${VIEW_W}/${VIEW_H}`}
>
  <svg class="mapf-draw" viewBox={`${view.x} ${view.y} ${VIEW_W} ${VIEW_H}`} aria-hidden="true">
    {blockMap.buildings.map((d) => <path class="mapf-b" d={d} />)}
    {byRank.map((street) => (
      <path class="mapf-s" d={street.d} stroke-width={WIDTH[street.rank as 1 | 2 | 3]} />
    ))}
    <g class="mapf-pin" transform={`translate(${blockMap.bar.x} ${blockMap.bar.y})`}>
      <circle class="mapf-pin-ring" r="17" />
      <circle class="mapf-pin-dot" r="6" />
    </g>
  </svg>

  <figcaption class="mapf-cap">
    <span>{t.kontakt.mapLabel}</span>
    <button class="mapf-open" type="button">{t.kontakt.mapOpen}</button>
  </figcaption>
</figure>

<script>
  import '../scripts/mapfacade';
</script>

<style is:global>
/* MAP FACADE — the drawing renders; clicking loads the real embed. The
   iframe is built in JS, so nothing can reach Google before a click. */
.mapf{
  position:relative;margin:12vh auto 0;max-width:52rem;width:100%;
  background:var(--bone);overflow:hidden;
  box-shadow:inset 0 0 0 1px var(--hair);
}
.mapf-draw{display:block;width:100%;height:100%}

.mapf-b{fill:var(--olive-deep);fill-opacity:.09;stroke:none}
.mapf-s{
  fill:none;stroke:var(--olive);stroke-opacity:.5;
  stroke-linecap:round;stroke-linejoin:round;
}

.mapf-pin-ring{fill:none;stroke:var(--amber-text);stroke-opacity:.5;stroke-width:2}
.mapf-pin-dot{fill:var(--amber-text)}

.mapf-cap{
  position:absolute;left:0;right:0;bottom:0;
  display:flex;align-items:center;justify-content:space-between;gap:1rem;
  padding:.9rem 1.1rem;
  font-family:var(--display);font-size:10px;letter-spacing:.28em;text-transform:uppercase;
  color:var(--label);
  background:linear-gradient(180deg,rgba(242,236,225,0),rgba(242,236,225,.92) 42%);
}
.mapf-open{
  font:inherit;letter-spacing:inherit;text-transform:inherit;
  color:var(--olive-deep);background:none;cursor:pointer;
  border:1px solid var(--hair);border-radius:2rem;padding:.5rem 1.1rem;
  transition:color .4s ease,border-color .4s ease;
}
.mapf-open:hover{color:var(--amber-text);border-color:var(--amber-text)}

/* Once loaded the embed takes the whole frame. It brings its own palette,
   which is exactly why it is not shown until someone asks for it. */
.mapf-frame{display:block;width:100%;height:100%;border:0}

@media(max-width:760px){
  .mapf{margin-top:9vh}
  .mapf-cap{padding:.75rem .85rem;gap:.6rem}
}
</style>
