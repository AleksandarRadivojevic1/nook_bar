---
import { fill, pluralNoun, useTranslations, type Locale } from '../i18n';
import { formatClock, formatDate } from '../lib/hours';
import { visibleSections, type SectionId } from '../lib/sections';
import { formatScore, site } from '../lib/site';
import Wordmark from './Wordmark.astro';

interface Props {
  locale: Locale;
  sections: ReadonlySet<SectionId>;
}

const { locale, sections } = Astro.props;
const t = useTranslations(locale);

// The complete index, same list the overlay menu renders.
const index = visibleSections(sections, 'menu');

// Derived from site.json, not typed into the dictionaries.
const rating = fill(t.footer.rating, {
  score: formatScore(site.reviewScore, locale),
  count: String(site.reviewCount),
  noun: pluralNoun(site.reviewCount, locale, t.recenzije.reviewNoun),
});

// Build-time values so nothing renders as a dash; clock.ts corrects them on
// the first frame — the page is prerendered, so this is the build's clock.
const now = new Date();
const clock = formatClock(now, locale);
const date = formatDate(now, locale);
const year = now.getFullYear();
---

<!-- The panel itself does not move on scroll. The one scripted thing here is
     the frame painting in when the page ends — see scripts/footer.ts. -->
<div class="footer-wrap" data-nav-surface="ink">
  <!-- The panel sticks for the last stretch of the page, so it is fully
       visible and full-bleed for a while before you actually reach the end.
       Without that runway there is nowhere for the frame to paint in. -->
  <div class="footer-stage">
    <div class="footer-bg">
      <div class="footer-bg-art"></div>
      <div class="footer-counter"></div>
    </div>

    <footer class="footer" id="footer">
    <div class="footer-inner">
      <div class="footer-grid">
        <dl class="fcol">
          <dt>{t.footer.menuCol}</dt>
          {index.map((s) => <a href={`#${s.id}`}>{t.nav[s.id]}</a>)}
        </dl>
        <dl class="fcol">
          <dt>{t.footer.socialCol}</dt>
          <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a>
          <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps</a>
        </dl>
        <dl class="fcol">
          <dt>{t.footer.locationCol}</dt>
          <div>{t.footer.location}</div>
          <div id="fdate">{date}</div>
          <div class="clock" id="fclock">{clock}</div>
        </dl>
        <dl class="fcol">
          <dt>{t.footer.ratingCol}</dt>
          <div>{rating}</div>
          <div style="color:rgba(247,242,232,.55)">Google</div>
        </dl>
      </div>
    </div>

    <div class="footer-legal">
      <div>© {year} Nook · Leskovac</div>
      <div>{t.footer.concept}</div>
    </div>

    <div class="footer-mark">
      <Wordmark class="footer-mark-svg" />
      </div>
    </footer>
  </div>
</div>

<script>
  import { startClock } from '../scripts/clock';
  import '../scripts/footer';

  const root = document.querySelector('.footer-wrap');
  const locale = document.querySelector('main')?.getAttribute('data-locale');
  if (root && (locale === 'sr' || locale === 'en')) startClock(root, locale);
</script>

<style is:global>
/* ══════════════════════════════════════════════════════════════════════
   ACT 7 — FOOTER  (rebuilt from the Flyward recon)
   ══════════════════════════════════════════════════════════════════════ */
/* Measured off Flyward: .section_footer is exactly 100vh with
   box-sizing:border-box and a 55px/39px border coloured the SAME as the page
   background — the border IS the frame, which is why the panel reads as inset.
   The artwork is a sibling behind it spanning the full width; the border
   paints the page colour back over its edges. The wordmark is clipped by just
   ~5px (their margin-bottom:-4.8px), not deeply cropped. */
.footer-wrap{position:relative;background:var(--bone);height:170vh}
.footer-stage{position:sticky;top:0;height:100vh;overflow:hidden}
.footer-bg{position:absolute;inset:0;z-index:1;overflow:hidden}
/* stand-in for the photograph: light pooled along the lower half, mirroring
   Flyward's object-position:50% 100%. Drop-in slot for a real image. */
.footer-bg-art{
  position:absolute;inset:0;
  background:
    radial-gradient(20% 22% at 31% 58%, rgba(255,222,168,.60), rgba(27,20,9,0) 76%),
    radial-gradient(15% 17% at 68% 66%, rgba(255,212,150,.42), rgba(27,20,9,0) 78%),
    linear-gradient(180deg,transparent 54%,rgba(255,206,138,.10) 55.2%,transparent 56.2%),
    radial-gradient(90% 40% at 44% 88%, rgba(201,138,68,.36), rgba(27,20,9,0) 78%),
    radial-gradient(120% 90% at 44% 72%, rgba(20,14,7,0) 24%, rgba(20,14,7,.82) 100%),
    linear-gradient(180deg,#1B1409 0%,#1B1409 34%,#3B2A17 74%,#1F1708 100%);
}
.footer-counter{
  position:absolute;left:0;right:0;top:78%;height:2px;z-index:2;
  background:linear-gradient(90deg,rgba(255,214,150,0) 14%,rgba(255,222,170,.5) 46%,rgba(255,214,150,0) 84%);
  box-shadow:0 10px 30px rgba(255,190,110,.20);
}
.footer{
  /* The border is painted in the PAGE colour, so it reads as a frame and the
     panel appears inset. footer.ts rewinds it to 0 and plays it in on
     reaching the end of the page; these values are the finished state. */
  position:relative;z-index:3;height:100vh;width:100%;box-sizing:border-box;
  border:solid var(--bone);
  border-width:clamp(2.4rem,6.1vh,3.45rem) clamp(.9rem,2.71vw,2.45rem) clamp(.9rem,2.71vw,2.45rem);
  background:transparent;color:#F7F2E8;
  display:flex;flex-direction:column;justify-content:flex-end;
}
.footer-inner{position:relative;z-index:4;padding:0 clamp(1.25rem,3vw,2.6rem)}
.footer-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2rem;padding-bottom:3.5vh;align-items:start}
@media(max-width:860px){.footer-grid{grid-template-columns:1fr 1fr;gap:2.2rem}}
.fcol dt{font-family:var(--display);font-size:10px;letter-spacing:.3em;text-transform:uppercase;
  color:rgba(247,242,232,.55);margin-bottom:1rem}
.fcol a,.fcol div{display:block;font-size:.92rem;line-height:2;color:rgba(247,242,232,.9)}
.fcol a{width:fit-content;transition:color .3s ease,transform .3s cubic-bezier(.2,.7,.2,1)}
.fcol a:hover{color:#fff;transform:translateX(5px)}
.clock{font-variant-numeric:tabular-nums}
/* legal sits INSIDE the panel, above the wordmark, as on Flyward */
.footer-legal{
  position:relative;z-index:4;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;
  padding:0 clamp(1.25rem,3vw,2.6rem) 2.2vh;
  font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:rgba(247,242,232,.5);
}
.footer-mark{position:relative;z-index:4;width:100%;margin-bottom:0;color:#F7F2E8}
.footer-mark svg{width:84%;height:auto;display:block;margin:0 auto}

</style>
