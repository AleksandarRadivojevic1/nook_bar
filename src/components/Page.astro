---
import type { Locale } from '../i18n';
import type { SectionId } from '../lib/sections';
import Hero from './sections/Hero.astro';
import Prostor from './sections/Prostor.astro';
import Dan from './sections/Dan.astro';
import Karta from './sections/Karta.astro';
import Potpis from './sections/Potpis.astro';
import Recenzije from './sections/Recenzije.astro';
import Galerija from './sections/Galerija.astro';
import Kontakt from './sections/Kontakt.astro';
import Footer from './Footer.astro';
import Nav from './Nav.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

/**
 * The sections this page actually renders, in page order. Nav, the overlay
 * menu and the footer all derive from this, so none of them can link to
 * something that is not here. Adding a section means adding its id here and
 * nothing else.
 *
 * Reviews sit directly before Kontakt on purpose: social proof does nothing
 * in the middle of a page. Before the decision point it builds — see the
 * room, hear that other people agree, here is the address.
 */
const present = new Set<SectionId>([
  'prostor',
  'dan',
  'karta',
  'potpis',
  'galerija',
  'recenzije',
  'kontakt',
]);
---

<Nav locale={locale} sections={present} />

<main data-locale={locale}>
  <Hero locale={locale} />
  <Prostor locale={locale} />
  <Dan locale={locale} />
  <Karta locale={locale} />
  <Potpis locale={locale} />
  <Galerija locale={locale} />
  <Recenzije locale={locale} />
  <Kontakt locale={locale} />
</main>

<Footer locale={locale} sections={present} />

<script>
  import { motion } from '../scripts/motion';
  import '../scripts/anchors';
  motion();
</script>
