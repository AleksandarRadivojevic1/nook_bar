---
import type { Locale } from '../i18n';
import Hero from './sections/Hero.astro';
import Prostor from './sections/Prostor.astro';
import Dan from './sections/Dan.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<main data-locale={locale}>
  <Hero locale={locale} />
  <Prostor locale={locale} />
  <Dan locale={locale} />
</main>

<script>
  import { motion } from '../scripts/motion';
  motion();
</script>
